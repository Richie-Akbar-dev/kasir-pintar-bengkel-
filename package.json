{
  "name": "kasir-pintar-bengkel",
  "version": "1.0.0",
  "private": true,
  "description": "Aplikasi kasir & manajemen bengkel untuk laptop Windows. Data tersimpan lokal.",
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite --strictPort",
    "app": "cross-env KASIR_DEV_URL=http://localhost:5173 tauri dev",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "seed": "node server/seed.js",
    "reset": "node server/seed.js --reset"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
