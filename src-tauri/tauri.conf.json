{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kasir Pintar Bengkel",
  "version": "1.0.0",
  "identifier": "com.richie.kasirpintarbengkel",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/henry.w@example.org",
      "icons/icon.ico"
    ],
    "resources": ["resources/app/**/*"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
